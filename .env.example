# Free key: https://aistudio.google.com/apikey  (paste it after the = sign, then restart the server)
GEMINI_API_KEY=

# Optional. Live conversation uses the fast gemini-3.5-flash-lite; reports use gemini-3.8-flash.
# If one is busy, the app switches to the other automatically.
# GEMINI_LIVE_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash

# Free interviews each new account starts with.
FREE_INTERVIEWS=5
